---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
---

{headings.length > 0 && (
	<nav class="table-of-contents p-4 rounded-2xl shadow-lg border border-white/20" style="background: inherit; background-color: rgba(255, 255, 255, .3); backdrop-filter: blur(5px);" aria-label="Table of contents">
		<h3 class="font-bold text-lg mb-3">On this page</h3>
		<ul class="space-y-2 text-sm">
			{headings.map((heading) => (
				<li class={heading.depth === 3 ? 'ml-4' : ''}>
					<a
						href={`#${heading.slug}`}
						data-toc-link={heading.slug}
						class="text-base-content/70 hover:text-primary transition-colors"
					>
						{heading.text}
					</a>
				</li>
			))}
		</ul>
	</nav>
)}

<script>
	// Highlight active TOC link based on scroll position
	document.addEventListener('DOMContentLoaded', () => {
		const tocLinks = document.querySelectorAll('[data-toc-link]');
		const headings = document.querySelectorAll('.prose h2[id], .prose h3[id]');

		if (headings.length === 0 || tocLinks.length === 0) return;

		// Create intersection observer with trigger zone near top
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					const id = entry.target.getAttribute('id');
					const tocLink = document.querySelector(`[data-toc-link="${id}"]`);

					if (entry.isIntersecting) {
						// Remove active class from all links
						tocLinks.forEach((link) => link.classList.remove('font-bold', 'text-primary'));
						// Add active class to current link
						tocLink?.classList.add('font-bold', 'text-primary');
					}
				});
			},
			{
				// Trigger zone: top 20% of viewport (accounts for header)
				rootMargin: '-7rem 0px -80% 0px',
				threshold: 0,
			}
		);

		// Observe all headings
		headings.forEach((heading) => observer.observe(heading));

		// Cleanup on page navigation
		document.addEventListener('astro:before-swap', () => observer.disconnect());
	});
</script>

<style is:global>
	/* Add scroll margin to headings so they appear below the sticky header */
	.prose h2[id],
	.prose h3[id] {
		scroll-margin-top: 7rem;
	}
</style>
